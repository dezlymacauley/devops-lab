# Any file or directory that has `.env` in its name,
# will not be uploaded to GitHub, unless it is called `.env.template`.
*.env*
!.env.template

# A `.env` file contains sensitive values that should never be
# uploaded to GitHub.

# The `.env.template` file is safe to upload to GitHub because it 
# is just a template that lists the variables are required in 
# a `.env` file of the project.
#______________________________________________________________________________

# Any `.terraform` directory, will not be uploaded to GitHub.
.terraform/

# A `.terraform` directory is where Terraform saves its cache to keep track 
# of your local workflow, and any Terraform modules 
# and Terraform providers that you have downloaded.
#______________________________________________________________________________
